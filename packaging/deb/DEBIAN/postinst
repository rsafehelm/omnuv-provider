#!/bin/sh
# Deliberately does not check what hypervisor this is.
#
# The driver layer exists so that a second runtime can arrive, and a package
# whose postinst runs `pveversion` is a package that cannot be installed on a
# Kubernetes provider. What kind of host this is, is the agent's question at
# join time, not the packager's at install time.
set -e

case "$1" in
  configure)
    if ! getent group onv >/dev/null; then
        addgroup --system onv
    fi
    if ! getent passwd onv >/dev/null; then
        adduser --system --ingroup onv --no-create-home \
                --home /var/lib/onv --shell /usr/sbin/nologin onv
    fi

    # Readable by the agent, writable only by root: it holds this provider's
    # own hypervisor credentials, which never leave this machine.
    mkdir -p /etc/onv
    chown root:onv /etc/onv
    chmod 0750 /etc/onv

    # `import` is where a mirrored image artefact lands before Proxmox takes
    # it: several gigabytes, written by the agent, referenced as a volume in a
    # storage of content type `import` because the agent's hypervisor token
    # deliberately lacks the privilege to name an arbitrary path.
    for d in /var/lib/onv /var/log/onv /var/lib/onv/snippets /var/lib/onv/import; do
        mkdir -p "$d"
        chown onv:onv "$d"
    done

    # Enabled, but not started: there is nothing to start until `join` has
    # written a configuration, and a service that restart-loops on a fresh
    # install teaches an operator to ignore it.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable onv-provider.service >/dev/null 2>&1 || true
        if [ -f /etc/onv/agent.yaml ]; then
            systemctl restart onv-provider.service || true
        else
            echo "onv-provider installed. Enrol this machine with:"
            echo
            echo "    sudo onv-provider join --token <your enrolment token>"
            echo
        fi
    fi
    ;;
esac
exit 0

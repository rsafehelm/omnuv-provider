#!/bin/sh
# Deliberately does not check what hypervisor this is.
#
# The driver layer exists so that a second runtime can arrive, and a package
# whose postinst runs `pveversion` is a package that cannot be installed on a
# Kubernetes provider. What kind of host this is, is the agent's question at
# join time, not the packager's at install time.
set -e

case "$1" in
  configure)
    if ! getent group onv >/dev/null; then
        addgroup --system onv
    fi
    if ! getent passwd onv >/dev/null; then
        adduser --system --ingroup onv --no-create-home \
                --home /var/lib/onv --shell /usr/sbin/nologin onv
    fi

    # Readable by the agent, writable only by root: it holds this provider's
    # own hypervisor credentials, which never leave this machine.
    mkdir -p /etc/onv
    chown root:onv /etc/onv
    chmod 0750 /etc/onv

    # `import` is where a mirrored image artefact lands before Proxmox takes
    # it: several gigabytes, written by the agent, referenced as a volume in a
    # storage of content type `import` because the agent's hypervisor token
    # deliberately lacks the privilege to name an arbitrary path.
    for d in /var/lib/onv /var/lib/onv/snippets /var/lib/onv/import; do
        mkdir -p "$d"
        chown onv:onv "$d"
    done
    # The log directory is the agent's to write and the `adm` group's to read,
    # which is what deploy-agent.yml sets. This set onv:onv on every upgrade,
    # undoing the play, and the play set it back on its next run.
    mkdir -p /var/log/onv
    chown onv:adm /var/log/onv
    chmod 0750 /var/log/onv
    # An audit log left root-owned by an earlier `join` (which opened it as
    # root) cannot be appended to by the agent; hand it over on upgrade.
    if [ -f /var/log/onv/audit.log ]; then
        chown onv:onv /var/log/onv/audit.log
        chmod 0640 /var/log/onv/audit.log
    fi

    if [ -d /run/systemd/system ]; then
        # **The journal's cap** (60-onv-provider.conf, omnuv's modular
        # design A4) is read when journald starts, so journald is restarted,
        # and only when the file differs from the one last applied: an
        # upgrade that leaves it alone restarts nothing. The file's hash is
        # recorded only once a restart succeeded, so a failed one is tried
        # again by the next configure rather than forgotten
        # (tests/logs/in_container.sh holds both).
        cap=/etc/systemd/journald.conf.d/60-onv-provider.conf
        applied=/var/lib/onv/journald-cap.sha256
        if [ -f "$cap" ]; then
            sum="$(sha256sum "$cap" | cut -d' ' -f1)"
            if [ "$sum" != "$(cat "$applied" 2>/dev/null || true)" ]; then
                if systemctl try-restart systemd-journald.service; then
                    printf '%s\n' "$sum" > "$applied"
                else
                    echo "onv-provider: journald was not restarted; its cap applies at its next start" >&2
                fi
            fi
        fi
    fi

    # Enabled, but not started: there is nothing to start until `join` has
    # written a configuration. The unit's ConditionPathExists keeps it from
    # starting, and restart-looping, before that.
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable onv-provider.service >/dev/null 2>&1 || true
        if [ -f /etc/onv/agent.yaml ]; then
            systemctl restart onv-provider.service || true
        else
            echo "onv-provider installed. Enrol this machine with:"
            echo
            echo "    sudo onv-provider join --core <https://your-core> --token <your enrolment token>"
            echo
        fi
        # **The host timer** (lifecycle phase 12): every minute, it stops each
        # machine past its run lease while the agent's lease task is not
        # running. Enabled and started after the agent's restart above, so
        # its first run meets the agent this package installed, which holds
        # the lease lock, and never the one it replaced. Before `join` its
        # service's ConditionPathExists skips each run.
        systemctl enable --now onv-lease-expire.timer >/dev/null 2>&1 || true
        # **The provider opening's applier** (opening.rs): at boot, and again
        # whenever the agent rewrites its ports. Started once now so the
        # kernel holds what the configuration says from this install on:
        # off, which is the default, removes the table. Before `join` its
        # ConditionPathExists skips it.
        systemctl enable onv-opening.service >/dev/null 2>&1 || true
        systemctl enable --now onv-opening.path >/dev/null 2>&1 || true
        systemctl start onv-opening.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0

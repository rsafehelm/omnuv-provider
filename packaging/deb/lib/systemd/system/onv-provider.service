[Unit]
Description=Omnuv Provider Agent
Documentation=https://github.com/rsafehelm/omnuv-provider
# pve-guests is a Proxmox unit and is simply absent elsewhere, which systemd
# treats as satisfied. The package must install on a host that is not Proxmox,
# because the driver layer exists so a second runtime can arrive.
After=network-online.target pve-guests.service
Wants=network-online.target
# Nothing to run until `join` has written a configuration. Without this the
# unit, enabled at install, started on every boot, failed on the missing file
# and was restarted every 10 s for as long as nobody joined.
ConditionPathExists=/etc/onv/agent.yaml

[Service]
Type=simple
ExecStart=/usr/bin/onv-provider agent --config /etc/onv/agent.yaml
# The agent refuses a plaintext Core URL: its credentials and this provider's
# inventory would cross the network in the clear. A development loop can opt in
# by dropping a file in /etc/systemd/system/onv-provider.service.d/ that sets
# OMNUV_ALLOW_PLAINTEXT_CORE=1, which is deliberately more effort than a flag.
User=onv
Group=onv
Restart=always
RestartSec=10s
# **Exit 3 is "stop for good"** (agent.rs, `stop_for_good`): Core will not
# work with this agent as it is, and only an upgrade or a re-enrolment
# changes that. Restart=always undid it every 10 s, for ever. 70 is a
# supervised task's panic (onv_agent_lib::supervise) and is restarted, and
# so is 2, a configuration refused, so a corrected file is picked up.
RestartPreventExitStatus=3
# ceiling: SIGTERM is honoured between passes, and a pass may be inside one
# hypervisor task the client waits up to 600 s for (proxmox.rs, wait_task);
# 60 s more for `release_session`. The default 90 s SIGKILLed such a pass
# before it released the session, and the successor then waited out Core's
# takeover lease. Unmeasured: passes are usually seconds.
TimeoutStopSec=660
# ceiling: unmeasured. A bound against a leak, not a budget: the agent holds
# small maps and streams image downloads to disk (agent.rs, bytes_stream),
# never whole. The page cache of a multi-gigabyte download is charged here
# too; at the bound the kernel reclaims it and throttles the writer rather
# than kill. Past it, the OOM kill ends the process and Restart=always
# starts it again.
MemoryMax=1G

# It talks to a local hypervisor API and to Core. It does not need root, and
# later phases that touch host devices should widen this deliberately rather
# than find it already open.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/onv /var/log/onv
# **The audit log directory is not declared here**, and that is deliberate.
# `LogsDirectory=` makes systemd create and then *re-chown* the path at every
# start, to the service's own User and Group — so it fought the bootstrap,
# which sets `onv:adm` 0750 so an operator can read the provider's own record
# without being root. Each reset the other on every run, forever, and neither
# was wrong on its own.
#
# The bootstrap owns the path; this only needs to be allowed to write to it.
StateDirectory=onv
# Nothing the agent creates is readable by other users (PROVIDER-21):
# snippets carry setup keys and password hashes, and are written 0600
# explicitly; this is the default for anything that is not. Group-readable
# on purpose, because /var/log/onv is onv:adm so an operator can read the
# audit log without being root.
UMask=0027
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

{
  "headers": {
    "session": "onv-session",
    "run_lease": "onv-run-lease",
    "restore": "onv-restore",
    "restore_detected": "onv-restore-detected",
    "report_interval": "onv-report-interval"
  },
  "routes": {
    "handshake": "/provider/v1/handshake",
    "inventory": "/provider/v1/inventory",
    "heartbeat": "/provider/v1/heartbeat",
    "session": "/provider/v1/session",
